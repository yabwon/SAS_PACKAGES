{
  "$schema": "https://raw.githubusercontent.com/sasjs/lint/main/sasjslint-schema.json",
  "allowedGremlins": [],
  "bannedStrings": [
  ],
  "defaultHeader": "/**{lineEnding}  @file{lineEnding}  @brief <Your brief here>{lineEnding}{lineEnding}  <h4> SAS Macros </h4>{lineEnding}{lineEnding}**/",
  "hasDoxygenHeader": false,
  "hasMacroNameInMend": true,
  "hasMacroParentheses": true,
  "hasRequiredMacroOptions": false,
  "ignoreList": [],
  "ignoredLibnames": [],
  "ignoredMacros": [
    "webout"
  ],
  "indentationMultiple": 1,
  "lineEndings": "off",
  "lowerCaseFileNames": false,
  "lowerCaseMacroNames": false,
  "maxDataLineLength": 160,
  "maxHeaderLineLength": 120,
  "maxLineLength": 242,
  "minMacroNameLength": 3,
  "noBannedStrings": true,
  "noEncodedPasswords": true,
  "noGremlins": true,
  "noMacroIfInOpenCode": false,
  "noMalformedMacroCalls": false,
  "noNestedCommentsInHeader": true,
  "noNestedMacros": true,
  "noSingleAsteriskComments": false,
  "noSpacesInFileNames": false,
  "noTabs": true,
  "noTrailingSpaces": false,
  "noUndeclaredMacros": true,
  "noUnusedLibnames": false,
  "noUnusedMacros": true,
  "noXcmd": false,
  "requiredMacroOptions": [],
  "severityLevel": {},
  "strictMacroDefinition": false
}